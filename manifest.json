{
  "manifest_version": 3,
  "name": "Image Detector & Downloader",
  "version": "1.0",
  "description": "Detects all images on a web page and allows users to download selected ones easily.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
